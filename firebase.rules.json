{
  "rules": {
    ".read": false,
    ".write": false,

    "clubs": {
      ".read": "auth != null && (auth.token.email === 'staff@etoa.app' || auth.token.email === 'viewer@etoa.app')",
      ".write": "auth != null && auth.token.email === 'staff@etoa.app'",
      "$club": {
        "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "logo": { ".validate": "newData.isString() && newData.val().length <= 70000" },
        "$other": { ".validate": false }
      }
    },

    "$club": {
      ".read": "auth != null && (auth.token.email === 'staff@etoa.app' || auth.token.email === 'viewer@etoa.app')",
      ".write": "auth != null && auth.token.email === 'staff@etoa.app'",
      ".validate": "$club.matches(/^[a-z0-9][a-z0-9-]{1,19}$/)",

      "users": {
        "$i": {
          "username": { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 20" },
          "display": { ".validate": "newData.isString() && newData.val().length <= 30" },
          "passwordHash": { ".validate": "newData.isString() && newData.val().length <= 128" },
          "role": { ".validate": "newData.val() === 'admin' || newData.val() === 'staff' || newData.val() === 'member' || newData.val() === 'pending'" },
          "createdAt": { ".validate": "newData.isNumber()" }
        }
      },

      "members": {
        "$i": {
          "id": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
          "gender": { ".validate": "newData.val() === 'M' || newData.val() === 'F'" },
          "grade": { ".validate": "newData.isString() && newData.val().matches(/^[ABCDN]$/)" },
          "guest": { ".validate": "newData.isBoolean()" },
          "createdAt": { ".validate": "newData.isNumber()" }
        }
      },

      "day": {
        "meta": {
          "date": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
          "courtCount": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4" },
          "queueRows": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4" },
          "autoAdvance": { ".validate": "newData.isBoolean()" },
          "fillCourts": { ".validate": "newData.isBoolean()" },
          "includePlaying": { ".validate": "newData.isBoolean()" },
          "session": {
            "no": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "startedAt": { ".validate": "newData.isNumber()" },
            "endedAt": { ".validate": "newData.isNumber()" }
          }
        },
        "sessions": {
          "$s": {
            "date": { ".validate": "newData.isString() && newData.val().length <= 10" },
            "no": { ".validate": "newData.isNumber()" },
            "games": { ".validate": "newData.isNumber() && newData.val() >= 0" }
          }
        },
        "courts": {
          "$c": {
            "startedAt": { ".validate": "newData.isNumber()" },
            "players": {
              "$s": { ".validate": "newData.isString() && newData.val().length <= 40" }
            }
          }
        },
        "queues": {
          "$q": {
            "$s": { ".validate": "newData.isString() && newData.val().length <= 40" }
          }
        },
        "attendance": { "$id": { ".validate": "newData.isBoolean()" } },
        "games": { "$id": { ".validate": "newData.isNumber() && newData.val() >= 0" } },
        "combos": { "$key": { ".validate": "newData.isNumber() && newData.val() >= 0" } },
        "pairs": { "$key": { ".validate": "newData.isNumber() && newData.val() >= 0" } },
        "history": {
          "$h": {
            "at": { ".validate": "newData.isNumber()" },
            "court": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4" },
            "scoreA": { ".validate": "newData.isNumber()" },
            "scoreB": { ".validate": "newData.isNumber()" }
          }
        },
        "$other": { ".validate": false }
      },

      "$other": { ".validate": false }
    }
  }
}
